Class FollowerSpawnHandler : EventHandler
{
	
	TravelLink Link;

    void FindTravelLink()
    {
        for (int i = 0; i < MAXPLAYERS; i++)
        {
            if (!playeringame[i])
                continue;

            PlayerPawn player = players[i].mo;

            if (!player)
                continue;

            Link = TravelLink(player.FindInventory("TravelLink"));

            if (Link)
                return;
        }
	}
	
	override void WorldLoaded(WorldEvent e)
	{
		FindTravelLink();
	}
	
    override void WorldThingSpawned(WorldEvent e)
    {
		Actor actor = e.thing;
		
        if (actor is "Follower_Marine")
        {	
			Link.LinkedActors.Push(Actor);
        }
    }
	
	static clearscope FollowerSpawnHandler Get()
	{
		return FollowerSpawnHandler(EventHandler.Find('FollowerSpawnHandler'));
	}
}