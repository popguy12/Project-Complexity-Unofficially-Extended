class JustaHUD : BaseStatusBar { //hud by nemesisvampy
	HUDFont Enligh; //smallfont
	HUDFont EnlighNoShadow; //shadowless smallfont
	HUDFont DBIGF; //bigfont
	InventoryBarState invbar;
	DynamicValueInterpolator HealthInterp;
	DynamicValueInterpolator ArmorInterp;
	Inventory lastAmmo;
	int lastAmount;
	double AmmoBarOffset;
	array<PC_HUDCasing> bulletCasings;
	double deltaTime, lastMSTime, lastTimescale;
	
	override void Init() {
		super.Init();
		Font fnt = "Enligh";
		Enligh = HUDFont.Create(fnt, 1, false, 2, 2);
		EnlighNoShadow = HUDFont.Create(fnt, 1, false, 0, 0);
		fnt = "DBIGF";
		DBIGF = HUDFont.Create(fnt, 1, false, 2, 2);
		HealthInterp = DynamicValueInterpolator.Create(100, 0.25, 1, 64);
		ArmorInterp = DynamicValueInterpolator.Create(100, 0.25, 1, 64);
	}
	
	override void Tick() {
		super.Tick();
		HealthInterp.Update(CPlayer.Health);
		let armor = CPlayer.mo.FindInventory("BasicArmor");
		if (armor)
		{
			ArmorInterp.Update(armor.amount);
		}
	}
	
	override void Draw(int state, double TicFrac) {
		super.Draw(state, TicFrac);
		
		if (state == HUD_None)
			return;
		double MSTime = MSTimeF();
		if(lastTimescale > i_timescale) lastMSTime *= i_timescale;
		else if(lastTimescale && lastTimescale < i_timescale) lastMSTime /= lastTimescale;
		deltaTime = (MSTime - lastMSTime) / (1000.0 / 60);
		lastMSTime = MSTime;
		lastTimescale = i_timescale;
		
		
		bool mugshotdisplay = CVar.GetCVar("SCH_MugshotDisplay", CPlayer).GetBool(); //mugshot
		bool vanillamode = CVar.GetCVar("Spooks_toastermode", CPlayer).GetBool(); //vanilla mode display
		
		BeginHUD();
		PC_DrawPowerupTimers();
		PC_DrawStats((10, 5));
		PC_DrawInvBar((0, 45));
		PC_DrawHealth();
		PC_DrawArmor();
		PC_DrawPowerupPanel((10, -48));
		PC_DrawRuneCooldowns();
		if(mugshotdisplay) PC_DrawMugshot((136, -38));
		if(vanillamode) PC_DrawVanillaMode((176, -29));
		PC_DrawKeys((176, -18));
		PC_DrawWeaponInfo();
		PC_TickCasings();
	}
	
	string PC_SetCounterColor(int CounterAmount = 0, int CounterMax = 0) //colorize text based on value
	{
		CVar extendedcolors = CVar.GetCVar("SCH_HealthArmorColor", CPlayer);
		if (CounterAmount > CounterMax && extendedcolors.GetInt() == 1)
			return "\ch";
		else if (CounterAmount > CounterMax / 2)
			return "\cq";
		else if (CounterAmount > CounterMax / 4)
			return "\cf";
		else if (CounterAmount > 0)
			return "\cg";
		else
			return "\cu";
	}
	
	void PC_DrawPowerupBar(vector2 basepos) //draws the top bar of powerup timer. adapted from bdp's hud by agent_ash
	{
		vector2 textPos = basePos;
		vector2 hudscale = GetHUDScale();
		int screenwidth = Screen.GetWidth() / hudscale.x;
		
		//iterate through player's inventory:
		for (let iitem = CPlayer.mo.Inv; iitem != NULL; iitem = iitem.Inv) 
		{
			let item = Powerup(iitem);
			if (item != null) 
			{
				string itemName = item.GetTag("notag"); //if a powerup doesn't have a tag we don't want to show it
				
				if (itemName != "notag")
				{
					DrawString(Enligh, "\cj"..itemName, textPos, DI_SCREEN_LEFT_TOP|DI_TEXT_ALIGN_CENTER);
					DrawString(Enligh, PC_SetCounterColor(Thinker.Tics2Seconds(item.EffectTics), Thinker.Tics2Seconds(item.MaxEffectTics))..FormatNumber(Thinker.Tics2Seconds(item.EffectTics), 3, 3, FNF_FILLZEROS), textPos + (0, 7), DI_SCREEN_LEFT_TOP|DI_TEXT_ALIGN_CENTER);
					textpos.x += 50;
					if (textpos.x >= screenwidth - 30) //if the counter would go off the screen, wrap around to another layer
					{
						textpos = (basePos.x, textpos.y + 14);
					}
				}
			}
		}
	}
	
	void PC_DrawPowerupPanel(vector2 basepos) //draws the bottom-left panel of persistent powerups, like runes and spheres. adapted from bdp's hud by agent_ash & nc hud by blue shadow
	{
		vector2 iconPos = basePos;
		
		//iterate through player's inventory:
		for (let iitem = CPlayer.mo.Inv; iitem != NULL; iitem = iitem.Inv) 
		{
			let item = Inventory(iitem);
			if (item != null && item is "PanelToken" && item.AltHUDIcon)
			{
				if (item is "VoidRuneToken")
				{
					if(CPlayer.mo.FindInventory("VoidRuneDepleted"))
					{
						DrawImage("BLRNE0", iconpos, DI_SCREEN_LEFT_BOTTOM|DI_ITEM_CENTER, 1, (18, 18));
					}
					else if(CPlayer.mo.FindInventory("VoidRuneRegA"))
					{
						DrawImage("BLRND0", iconpos, DI_SCREEN_LEFT_BOTTOM|DI_ITEM_CENTER, 1, (18, 18));
					}
					else if(CPlayer.mo.FindInventory("VoidRuneRegB"))
					{
						DrawImage("BLRNC0", iconpos, DI_SCREEN_LEFT_BOTTOM|DI_ITEM_CENTER, 1, (18, 18));
					}
					else if(CPlayer.mo.FindInventory("VoidRuneRegC"))
					{
						DrawImage("BLRNB0", iconpos, DI_SCREEN_LEFT_BOTTOM|DI_ITEM_CENTER, 1, (18, 18));
					}
					else
					{
						DrawImage("BLRNA0", iconpos, DI_SCREEN_LEFT_BOTTOM|DI_ITEM_CENTER, 1, (18, 18));
					}
				}
				else
				{
					DrawTexture(item.AltHUDIcon, iconpos, DI_SCREEN_LEFT_BOTTOM|DI_ITEM_CENTER, 1, (18, 18));
				}
				iconPos.y -= 20;
				if (iconpos.y <= -248) //ten items tall
				{
					iconpos = (iconpos.x + 20, basepos.y);
				}
			}
		}
	}
	
	void PC_DrawRuneCooldowns() {
		let idamager = Powerup(CPlayer.mo.FindInventory("PowerRD"));
		let idamagec = Powerup(CPlayer.mo.FindInventory("PowerCDP"));
		
		if (idamager||idamagec) {
			DrawImage("ISRNA0", (274, -23), DI_SCREEN_LEFT_BOTTOM|DI_ITEM_CENTER);
			if (idamager) {
				DrawString(Enligh, "\c[megaarmorred]"..FormatNumber(Thinker.Tics2Seconds(idamager.EffectTics), 3, 3, FNF_FILLZEROS), (294, -20), DI_SCREEN_LEFT_BOTTOM|DI_TEXT_ALIGN_CENTER);
			}
			if (idamagec) {
				DrawString(Enligh, "\ck"..FormatNumber(Thinker.Tics2Seconds(idamagec.EffectTics), 3, 3, FNF_FILLZEROS), (294, -30), DI_SCREEN_LEFT_BOTTOM|DI_TEXT_ALIGN_CENTER);
			}
		}
	}
	
	int PC_CheckInv(Inventory CheckedItem, int FalseValue, int TrueValue) //output a value that changes if the given item exists
	{
		if(CheckedItem)
			return TrueValue;
		else
			return FalseValue;
	}
	
	void PC_DrawStatCounter(string Prefix, int HOffset, int VOffset, int Value, int Total) { //create a stat counter in the top left of the screen. supports up to 5 digit stats
		DrawString(Enligh, "\cj"..Prefix, (HOffset - 1, VOffset), DI_SCREEN_LEFT_TOP|DI_TEXT_ALIGN_LEFT);
		DrawString(Enligh, "\cj/", (HOffset + 41, VOffset), DI_SCREEN_LEFT_TOP|DI_TEXT_ALIGN_LEFT);
		DrawString(Enligh, "\c[Dtgreen]"..Value, (HOffset + 38, VOffset), DI_SCREEN_LEFT_TOP|DI_TEXT_ALIGN_RIGHT);
		DrawString(Enligh, "\cd"..Total, (HOffset + 51, VOffset), DI_SCREEN_LEFT_TOP|DI_TEXT_ALIGN_LEFT);
	}
	
	void PC_DrawInventoryBar(Vector2 position, int numfields, int flags = 0) { //i redefined this because i'm too dumb to figure out how to do it normally. barely customizable because we don't really need it to be
		Vector2 boxsize = (32, 32);
		
		double width = boxsize.X * numfields;
		[position, flags] = AdjustPosition(position, flags, width, boxsize.Y);
		
		CPlayer.mo.InvFirst = ValidateInvFirst(numfields);
		if (CPlayer.mo.InvFirst == null) return; //player has no listed inventory items.
		
		//now the items and the rest
		Vector2 itempos = position + boxsize / 2;
		Vector2 textpos = position + boxsize - (4, 27);
		
		int i = 0;
		Inventory item;
		for(item = CPlayer.mo.InvFirst; item != NULL && i < numfields; item = item.NextInv())
		{
			for(int j = 0; j < 2; j++)
			{
				if (j ^ !!(flags & DI_DRAWCURSORFIRST))
				{
					if (item == CPlayer.mo.InvSel)
					{
						DrawImage("SELECTBO", position + (32 * i, 0), flags | DI_ITEM_LEFT_TOP);
					}
				}
				else
				{
					DrawInventoryIcon(item, itempos + (32 * i, 0), flags | DI_ITEM_CENTER, 1, (30, 30));
				}
			}
			
			DrawString(Enligh, "\c[Dtgreen]"..FormatNumber(item.Amount, 0, 5), textpos + (32 * i, 0), flags | DI_TEXT_ALIGN_RIGHT, Font.CR_WHITE);
			i++;
		}
	}
	
	static const String KeyExceptions[] =
	{
		"BlueCard",
		"RedCard",
		"YellowCard",
		"BlueSkull",
		"RedSkull",
		"YellowSkull"
	};
    
    virtual void PC_DrawKeys(vector2 pos, int keycount = 10, int space = 8) {
        //From NC HUD
        textureid icon, iconskull, iconcard;
        vector2 size;
        bool scaleup;
        string keyactorname;
		
        for(let i = CPlayer.mo.inv; i != null; i = i.inv)
        {
            if(i is "Key")
            {
                icon = i.AltHUDIcon;
                keyactorname = i.GetClassName();
				
                if(!icon.isValid())
                {
                    if(i.SpawnState && i.SpawnState.sprite != 0)
                    {
                        icon = i.SpawnState.GetSpriteTexture(0);
                    }
                    else
                    {
                        icon = i.icon;
                    }
					
                    if(!icon.isValid())
                    {
                        continue;
                    }
                }
                
              	for (int i = 0; i < KeyExceptions.Size(); i++)
		        {
                    if(keyactorname == KeyExceptions[i])
                    {
						icon = texman.checkfortexture("TNT1A0");
                    }
                }
				
                //Exclude keys which use TNT1 A 0 as their icon
                if(TexMan.GetName(icon) == "TNT1A0")
                {
                    continue;
                }
                
                //Scale the icon up if needed
                size = TexMan.GetScaledSize(icon);
                scaleup = (size.x <= 8 && size.y <= 8);
				DrawTexture(icon, (pos.x, pos.y), DI_SCREEN_LEFT_BOTTOM|DI_ITEM_OFFSETS, box : (16, 16), scaleup ? (2, 2) : (1, 1));
				pos.x += space;
            }
        }
    }
	
	void PC_DrawPowerupTimers() {
		//begin top modules
		PC_DrawPowerupBar((110, 5)); //draw the powerups bar
	}
	
	void PC_DrawStats(Vector2 pos) {
		//top left module
		bool statcounters = CVar.GetCVar("SCH_KISDisplay", CPlayer).GetBool(); //stat counters
		int counterdetail = CVar.GetCVar("SCH_KISINFO", CPlayer).GetInt();
		bool showclock = CVar.GetCVar("SCH_ClockDisplay", CPlayer).GetBool();
		int coffset = pos.y;
		if (statcounters) {
			if (counterdetail < 3) {
				PC_DrawStatCounter("K", pos.x, coffset, Level.killed_monsters, Level.total_monsters);
				coffset += 7;
			}
			if (counterdetail == 0) {
				PC_DrawStatCounter("I", pos.x, coffset, Level.found_items, Level.total_items);
				coffset += 7;
			}
			if (counterdetail < 2) {
				PC_DrawStatCounter("S", pos.x, coffset, Level.found_secrets, Level.total_secrets);
				coffset += 7;
			}
			DrawString(Enligh, "\cjKills:", (pos.x - 1, coffset), DI_SCREEN_LEFT_TOP|DI_TEXT_ALIGN_LEFT);
			DrawString(Enligh, "\c[Dtgreen]"..CPlayer.KillCount, (pos.x + 32, coffset), DI_SCREEN_LEFT_TOP|DI_TEXT_ALIGN_LEFT);
			coffset += 7;
		}
		if (showclock) {
			int CurrentTime = Thinker.Tics2Seconds(Level.time);
			DrawString(Enligh, String.Format("\cd%02d\cj:\cd%02d\cj:\cd%02d", CurrentTime / 3600, (CurrentTime % 3600) / 60, CurrentTime % 60), (pos.x - 1, coffset), DI_SCREEN_LEFT_TOP|DI_TEXT_ALIGN_LEFT);
		}
	}
	
	void PC_DrawInvBar(Vector2 pos) {
		if(!isInventoryBarVisible()) return;
		PC_DrawInventoryBar(pos, 6, DI_SCREEN_CENTER|DI_ITEM_CENTER);
	}
	
	void PC_DrawHealth() {
		int curHealth = HealthInterp.GetValue();
		bool str = CPlayer.mo.FindInventory("PowerStrength"); //check for berserk
		DrawImage(str ? "PSTRA0" : "MPAKB0", (7, -8), DI_SCREEN_LEFT_BOTTOM|DI_ITEM_LEFT_BOTTOM);
		DrawString(DBIGF, PC_SetCounterColor(HealthInterp.GetValue(), 100)..HealthInterp.GetValue(), (50, -23), DI_SCREEN_LEFT_BOTTOM|DI_TEXT_ALIGN_RIGHT);
		DrawString(Enligh, "\cjHP", (63, -18), DI_SCREEN_LEFT_BOTTOM|DI_TEXT_ALIGN_RIGHT);
		DrawBar("pcbar"..FormatNumber(ceil(curHealth / 100.0)), "pcbar"..FormatNumber(floor(curHealth / 100.0)), curHealth % 100, 100, (12, -5), 0, SHADER_HORZ, DI_SCREEN_LEFT_BOTTOM|DI_ITEM_LEFT);
	}
	
	void PC_DrawArmor() {
		let armor = CPlayer.mo.FindInventory("BasicArmor");
		if(!armor) return;
		int curArmor = ArmorInterp.GetValue();
		if(armor.Amount > 0)
			DrawInventoryIcon(armor, (80, -10), DI_SCREEN_LEFT_BOTTOM|DI_ITEM_OFFSETS);
		DrawString(DBIGF, PC_SetCounterColor(curArmor, 100)..curArmor, (113, -23), DI_SCREEN_LEFT_BOTTOM|DI_TEXT_ALIGN_RIGHT);
		DrawString(Enligh, String.Format("\c[Dtgreen]%d\cj&", GetArmorSavePercent()), (133, -25), DI_SCREEN_LEFT_BOTTOM|DI_TEXT_ALIGN_RIGHT); //janky ass font bullshit
		DrawString(Enligh, "\cjAP", (126, -18), DI_SCREEN_LEFT_BOTTOM|DI_TEXT_ALIGN_RIGHT);
		DrawBar("pcbar"..FormatNumber(ceil(curArmor / 100.0)), "pcbar"..FormatNumber(floor(curArmor / 100.0)), curArmor % 100, 100, (75, -5), 0, SHADER_HORZ, DI_SCREEN_LEFT_BOTTOM|DI_ITEM_LEFT);
	}
	
	void PC_DrawMugshot(Vector2 pos) {
		DrawTexture(GetMugShot(5, MugShot.ANIMATEDGODMODE), pos, DI_SCREEN_LEFT_BOTTOM|DI_ITEM_OFFSETS);
	}
	
	void PC_DrawVanillaMode(Vector2 pos) {
		DrawString(Enligh, "\cgLow SFX", pos, DI_SCREEN_LEFT_BOTTOM|DI_TEXT_ALIGN_LEFT);
	}
	
	void PC_DrawWeaponInfo() {
		let weap = JustaWeapon(CPlayer.readyweapon);
		
		//bottom right module
		Inventory am1, am2;
		[am1, am2] = GetCurrentAmmo();
		
		int mineamount, minemax;
		[mineamount, minemax] = GetAmount('MineAmmo');
		
		int nadeamount, nademax;
		[nadeamount, nademax] = GetAmount('HGAmmo');
		
		int c4amount, c4max;
		[c4amount, c4max] = GetAmount('C4Ammo');
		
		DrawString(Enligh, PC_SetCounterColor(mineamount, minemax)..FormatNumber(mineamount, 0, 2), (-114, PC_CheckInv(am1, -32, -47)), DI_SCREEN_RIGHT_BOTTOM|DI_TEXT_ALIGN_CENTER); //draw mine & nade counters
		DrawImage("LMINA0", (-95, PC_CheckInv(am1, -30, -43)), DI_SCREEN_RIGHT_BOTTOM|DI_ITEM_CENTER, 1, (-1, -1), (0.6, 0.6));
		DrawString(Enligh, PC_SetCounterColor(nadeamount, nademax)..FormatNumber(nadeamount, 0, 2), (-78, PC_CheckInv(am1, -32, -47)), DI_SCREEN_RIGHT_BOTTOM|DI_TEXT_ALIGN_CENTER);
		DrawImage("GRNDG0", (-59, PC_CheckInv(am1, -30, -43)), DI_SCREEN_RIGHT_BOTTOM|DI_ITEM_CENTER, 1, (-1, -1), (0.5, 0.5));
		DrawString(Enligh, PC_SetCounterColor(c4amount, c4max)..FormatNumber(c4amount, 0, 2), (-42, PC_CheckInv(am1, -32, -47)), DI_SCREEN_RIGHT_BOTTOM|DI_TEXT_ALIGN_CENTER);
		DrawImage("PIPBB0", (-23, PC_CheckInv(am1, -30, -43)), DI_SCREEN_RIGHT_BOTTOM|DI_ITEM_CENTER, 1, (-1, -1), (0.4, 0.4));
		
		if (CPlayer.mo.InvSel) { //show the currently selected item 
			DrawInventoryIcon(Cplayer.mo.InvSel, (-31, PC_CheckInv(am1, -51, -64)), DI_SCREEN_RIGHT_BOTTOM|DI_ITEM_CENTER, 1, (30, 30));
			DrawString(Enligh, "\c[Dtgreen]"..CPlayer.mo.InvSel.amount, (-19, PC_CheckInv(am1, -47, -60)), DI_SCREEN_RIGHT_BOTTOM|DI_TEXT_ALIGN_RIGHT);
		}
		
		if(CPlayer.mo.FindInventory("BackpackItem", true) && CVar.GetCVar("SCH_BackPackDisplay", CPlayer).GetBool()) {
			DrawImage("BPAKB0", (-71, PC_CheckInv(am1, -51, -64)), DI_SCREEN_RIGHT_BOTTOM|DI_ITEM_CENTER);
		}
		
		if (am1) { //if the weapon pulls from a mag
			DrawString(DBIGF, PC_SetCounterColor(am1.amount, am1.maxamount)..FormatNumber(am1.amount, 0, 3), (PC_CheckInv(am2, -36, -77), -36), DI_SCREEN_RIGHT_BOTTOM|DI_TEXT_ALIGN_RIGHT);
			if(!am2) DrawTexture(am1.Icon, (-23, -30), DI_SCREEN_RIGHT_BOTTOM|DI_ITEM_CENTER, 1, (16, 16));
			
			Vector2 CaseSize;
			if(weap && weap.CaseGraphic && TexMan.CheckForTexture(weap.CaseGraphic)) [CaseSize.x, CaseSize.y] = TexMan.GetSize(TexMan.CheckForTexture(weap.CaseGraphic));
			int StartPos = -170;
			if(caseSize.x && am1.MaxAmount < 70 / CaseSize.x) StartPos += (70 / CaseSize.x - am1.MaxAmount) * CaseSize.x;
			if(!am2) startPos += 30;
			if(!level.WorldPaused()) {
				if(lastAmmo != am1) {
					AmmoBarOffset = 0;
					lastAmount = am1.amount;
				}
				if(AmmoBarOffset > 0) AmmoBarOffset -= AmmoBarOffset / 7 * deltaTime;
				for(int i = 0; i < lastAmount - am1.amount; i++) {
					AmmoBarOffset += CaseSize.x;
					if(weap.CaseGraphic) {
						let b = PC_HUDCasing.Create(weap.CaseGraphic, (StartPos + clamp(CaseSize.x * i, 0, 70), -31));
						if(b) bulletCasings.Push(b);
					}
				}
				lastAmmo = am1;
				lastAmount = am1.amount;
			}
			if(weap && weap.BarGraphic && weap.CaseGraphic) {
				double barLength = clamp(CaseSize.x * am1.amount, 0, 70);
				if(AmmoBarOffset && am1.amount >= 70 / CaseSize.x) barLength -= AmmoBarOffset;
				if(AmmoBarOffset < 70) {
					SetClipRect(StartPos - 3 + AmmoBarOffset, -(31 + CaseSize.y / 2), barLength, CaseSize.y, DI_SCREEN_RIGHT_BOTTOM);
					DrawImage(weap.BarGraphic, (StartPos - 3 + AmmoBarOffset, -31), DI_SCREEN_RIGHT_BOTTOM|DI_ITEM_LEFT|DI_ITEM_VCENTER);
					ClearClipRect();
				}
			}
			else if(weap && weap.BarGraphic && weap.MedBar && weap.LowBar) {
				double cur = am1.amount;
				double max = am1.maxamount;
				double barPoint = (cur / max) * 70;
				double bP2 = 70 - barPoint;
				string bar = weap.BarGraphic;
				if(cur <= max / 2) bar = weap.MedBar;
				if(cur <= max / 4) bar = weap.LowBar;
				SetClipRect(StartPos - 3 + bP2, -50, barPoint, 50, DI_SCREEN_RIGHT_BOTTOM);
				DrawImage(bar, (StartPos - 3, -31), DI_SCREEN_RIGHT_BOTTOM|DI_ITEM_LEFT|DI_ITEM_VCENTER);
				ClearClipRect();
			}
		}
		
		PC_DrawReserveAmmo((-23, -30), am2);
		PC_DrawThrowBar((0, -12));
		PC_DrawWeaponTag((-18, -21));
		PC_DrawWeaponSlots((-83, -12));
	}
	
	void PC_DrawReserveAmmo(Vector2 pos, Inventory am2) {
		if (am2) { //if the weapon pulls from the player's reserves
			DrawString(DBIGF, PC_SetCounterColor(am2.amount, am2.maxamount)..FormatNumber(am2.amount, 0, 3), (pos.x - 13, pos.y - 6), DI_SCREEN_RIGHT_BOTTOM|DI_TEXT_ALIGN_RIGHT);
			DrawTexture(am2.Icon,pos, DI_SCREEN_RIGHT_BOTTOM|DI_ITEM_CENTER, 1, (16, 14));
		}
	}
	
	void PC_DrawThrowBar(Vector2 pos) {
		let weap = JustaWeapon(CPlayer.readyweapon);
		if(!weap | weap.throwStrength < 1) return;
		bool str = CPlayer.mo.FindInventory("PowerStrength");
		DrawBar(str ? "pcbar4" : "pcbar1", "pcbar0", weap.throwStrength - 15, str ? 40 : 20, pos, 0, SHADER_HORZ, DI_SCREEN_CENTER_BOTTOM|DI_ITEM_CENTER);
	}
	
	void PC_DrawWeaponTag(Vector2 pos) {
		if(!CPlayer.readyweapon) return;
		DrawString(Enligh, CPlayer.readyweapon.GetTag(), pos, DI_SCREEN_RIGHT_BOTTOM|DI_TEXT_ALIGN_RIGHT);
	}
	
	void PC_DrawWeaponSlots(Vector2 pos) {
		for(int i = 1; i < 10; i++) { //draw the weapons bar
			DrawString(Enligh, CPlayer.HasWeaponsInSlot(i)? "\cd"..i : "\cq"..i, (pos.x + i * 7, pos.y), DI_SCREEN_RIGHT_BOTTOM|DI_TEXT_ALIGN_CENTER);
		}
		if(!CPlayer.ReadyWeapon) return;
		DrawString(EnlighNoShadow, FormatNumber(CPlayer.ReadyWeapon.SlotNumber, 1, 1, 0, "\c[Cellcolor]"), (pos.x + CPlayer.ReadyWeapon.SlotNumber * 7, pos.y), DI_SCREEN_RIGHT_BOTTOM|DI_TEXT_ALIGN_CENTER);
	}
	
	void PC_TickCasings() {
		for(int i = 0; i < bulletCasings.Size(); i++) {
			if(!bulletCasings[i]) continue;
			bulletCasings[i].Tick(deltaTime);
		}
	}
}

class PC_HUDCasing : Object ui {
	string texture;
	double lifetime;
	Vector2 accel;
	Vector2 currentPos;
	double rotation;
	
	static PC_HudCasing Create(string texture, Vector2 startPos) {
		let b = PC_HUDCasing(new("PC_HUDCasing"));
		if(!b) return b;
		b.texture = Texture;
		b.lifetime = 200;
		b.currentPos = startPos;
		b.accel = (-4.0 * cfrandom(0.8, 1.2), -8.0 * cfrandom(0.8, 1.2));
		StatusBar.DrawImage(texture, startPos, StatusBarCore.DI_ITEM_CENTER);
		return b;
	}
	
	void Tick(double deltaTime) {
		StatusBar.DrawImageRotated(texture, currentPos, StatusBarCore.DI_ITEM_CENTER, rotation);
		if(level.WorldPaused()) return;
		accel += (0.04, 0.8) * deltaTime;
		currentPos += accel * deltaTime;
		rotation += 10 * deltaTime;
		lifetime -= deltaTime;
		if(!lifetime || currentPos.y > 0) Destroy();
	}
}