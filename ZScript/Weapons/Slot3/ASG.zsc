class Shellmag : Ammo
{
	Default
	{
	  Inventory.Amount 0;
	  Inventory.MaxAmount 20;
	  Ammo.BackpackAmount 0;
	  Ammo.BackpackMaxAmount 20;
	  Inventory.Icon "SHELLS";
	  +INVENTORY.IGNORESKILL;
  }
}

class Justasaltshotgun : JustaWeapon
{
	Default
	{
		Weapon.AmmoType1 "Shellmag";
		Weapon.AmmoType2 "Shells";
		Weapon.AmmoGive2 10;
		Weapon.Slotnumber 3;
		Weapon.SelectionOrder 1000;
		Weapon.SlotPriority 20;
		Obituary "%k was peppered with automatic shotgun fire.";
		Inventory.PickupSound "Weapon/SAbolt";
		Inventory.Pickupmessage "[3] - \c[brighterOrange]Assault shotgun\c- acquired.";
		Tag "$PC_ASGTAG";
		Inventory.AltHUDIcon "ASGPA0";
		Scale 0.8;
		JustaWeapon.BarGraphic "ShellBar";
		JustaWeapon.CaseGraphic "Shell";
	}
	
	action void PC_FireASG() {
		A_AlertMonsters();
		PC_PlayPowerModSounds();		
		A_startsound("Weapons/SAfire",10);
		A_GunFlash();
		PC_FireBullets("PC_ShotgunProjectile", 4.5, 4.5, 10);
		PC_TakeAmmo("ShellMag");
		PC_GunSmoke(0,3,3);
	}
	
	States
	{
		spawn:
			ASGP A -1;
			Stop;
		Select:
			A9SM BA 1 A_WeaponReady(WRF_NOFIRE);
			A9SG A 1 A_WeaponReady(WRF_NOFIRE);
			Goto ready;
		Deselect:
			A9SG A 1;
			A9SM AB 1;
			TNT1 A 0 A_lower;
			wait;
		Ready:
			A9SG A 1 PC_WeaponReady();
			Loop;
		Dryfire:
			A9SG A 4 A_startsound("Weapons/ShotgunEempty",11);
			goto ready;
		Fire:
			TNT1 A 0 A_Jumpifinventory("Shellmag",1,1);
			Goto Dryfire;
			A9SF A 1 BRIGHT PC_FireASG();
			A9SF B 1 BRIGHT;
			A9SF C 1 {
				PC_SpawnCasing("Spentshell", 24, 4, 32, frandom(2.0, 3.0), frandom(5.0, 6.0), frandom(4.0, 5.0));
				PC_QuakeCamera(2,4);
				A_ZoomFactor(0.99,ZOOM_INSTANT);
				PC_WeaponRecoil(4,4);
			}
			A9SF D 1 A_ZoomFactor(0.995);
			A9SF E 1 A_ZoomFactor(1.0);
			A9SF F 1;
			A9SG A 1 A_refire("Fire");
			Goto Ready;
		Reload:
			TNT1 A 0 A_JumpIfInventory("Shellmag", 20, 2);
			TNT1 A 0 A_JumpIfInventory("Shells", 1, "Reloadwork");
			A9SG A 1;
			Goto ready;
		ReloadWork:
			TNT1 A 0 A_JumpIfInventory("Shellmag",1,"ReloadWork2");
			TNT1 A 0 A_GiveInventory("ASGChamberloading",1);
		ReloadWork2:
			AUSR ABCDEFG 1;
			AUSR H 2 A_startsound("Weapon/SAMagout",9);
			AUSR IJKLMN 1;
			TNT1 A 0 A_FireProjectile("Drumspawner",0,0,10,1-20);
			AUSR N 20;
			AUSR OPQRST 1;
			AUSR U 2 A_startsound("Weapon/SAMAgin",10);
			AUSR W 1;
			TNT1 A 0 PC_AmmoIntoMag();
			AUSR X 2;
			TNT1 A 0 A_JumpIfInventory("ASGChamberloading",1,"Reloadcock"); //x to 2 k
			AUS2 KLMNOP 1;
			A9SG A 2;
			Goto ready;
		Reloadcock:
			AUSR XYZ 1;
			AUS2 A 2 A_startsound("Weapons/PUMPB",11);
			AUS2 ABC 1;
			AUS2 C 6;
			TNT1 A 0 A_startsound("Weapons/PUMPF",12);
			AUS2 DEFGHIJKLMNOP 1;
			A9SG A 2;
			TNT1 A 0 A_takeinventory("ASGChamberloading",1);
			Goto Ready;
		Flash:
			TNT1 A 2 A_Light2;
			TNT1 A 2 A_Light1;
			Goto LightDone;
		Throw:
			A9SM AB 1;
			TNT1 A 0 PC_GetThrowState();
			Wait;
		Returnstate:
			A9SM BA 1;
			A9SG A 1;
			Goto Ready;
	}
}