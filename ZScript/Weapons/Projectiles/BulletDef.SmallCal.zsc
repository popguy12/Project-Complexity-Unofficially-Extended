class PC_PistolProjectile : PC_Projectile
{
	Default
	{
		PC_Projectile.BaseDamage 15;
		PC_Projectile.RipperCount 2;
		PC_Projectile.SpeedFPS 1312;
		Obituary "%o met %k's Schmeisser.";
	}
	
	override void OnExplode(int type)
	{
		Spawn("PistolPuff", pos - velDir);
	}
}

class PC_RevolverProjectile : PC_Projectile
{
	Default
	{
		PC_Projectile.BaseDamage 100;
		PC_Projectile.RipperCount 2;
		PC_Projectile.SpeedFPS 1450;
		Obituary "%o had %p face splattered everywhere by a large fucking bullet.";
	}
	
	override void OnExplode(int type)
	{
		Spawn("RevolverPuff", pos - velDir);
	}
}

class PC_ExMagProjectile : PC_Projectile
{
	Default
	{
		PC_Projectile.BaseDamage 100;
		PC_Projectile.SpeedFPS 1450;
		-RIPPER
		Decal "Rocketscorch";
		Obituary "%o had %p face splattered everywhere by a large fucking bullet.";
	}
	
	override void OnExplode(int type)
	{
		Spawn("ESGpuff", pos - velDir);
	}
}
