class PistolClip : Ammo {
	Default {
		Inventory.Amount 0;
		Inventory.MaxAmount 15;
		Ammo.BackpackAmount 0;
		Ammo.BackpackMaxAmount 15;
		Inventory.Icon "CLIPB0";
		+INVENTORY.IGNORESKILL;
	}
}

class Justapistol : JustaWeapon replaces Pistol {
	Default {
		Weapon.AmmoType1 "PistolClip";
		Weapon.AmmoType2 "Bullets";
		Weapon.AmmoGive2 15;
		Weapon.slotnumber 2;
		Weapon.SlotPriority 10;
		Weapon.SelectionOrder 1900;
		Inventory.AltHUDIcon "PISTX0";
		Obituary "%k Was SHOT THROUGH THE HEART.";
		Inventory.PickupSound "Pistol/cock";
		Inventory.Pickupmessage "[2] - \c[Yellow]Combat pistol\c- acquired.";
		Tag "$PC_PISTOLTAG";
		Scale 0.65;
		JustaWeapon.BarGraphic "PBullBar";
		JustaWeapon.CaseGraphic "PBullet";
	}
	
	bool silenced;
	
	action void PC_SetSilenced(bool set) {
		invoker.silenced = set;
	}
	
	action bool PC_GetSilenced() {
		return invoker.silenced;
	}
	
	action void PC_SetSilencedSprite(name sprite) {
		if(PC_GetSilenced()) PC_SetSprite(sprite);
	}
	
	action void PC_FirePistol()
	{
		bool silenced = PC_GetSilenced();
		
		PC_PlayPowerModSounds();
		A_StartSound(silenced ? "Pistol/fire2" : "Pistol/fire", CHAN_WEAPON);
		if(!silenced) A_AlertMonsters();
		PC_GunSmoke(0, 3, 3);
		A_GunFlash();
		PC_FireBullets("PC_PistolProjectile", 1.4, 1.4);
		PC_TakeAmmo("PistolClip");
	}
	
	action void PC_PistolRecoil() {
		A_WeaponOffset(0, 34);
		PC_SpawnCasing("PistolCasing", 5, 0, 43, frandom(2.0, 3.0), frandom(5.0, 6.0), frandom(4.0, 5.0));
		PC_WeaponRecoil(1, 1);
		PC_QuakeCamera(2, 1);
		A_ZoomFactor(0.99, ZOOM_INSTANT);
	}
	
	States {
		Spawn:
			PIST X -1;
			Stop;
		Select:
			PISM A 0 PC_SetSilencedSprite("SILM");
			#### CBA 1 A_WeaponReady(WRF_NOFIRE);
			Goto Ready;
		Deselect:
			PISM A 0 PC_SetSilencedSprite("SILM");
			#### ABC 1;
			TNT1 A 0 A_Lower();
			Wait;
		Ready:
			PIST F 0 PC_SetSilencedSprite("SILE");
			#### F 1 PC_WeaponReady();
			Wait;
		Suppresstemp:
			PIST F 0 PC_SetSilencedSprite("SILE");
			#### F 6 PC_WeaponReady(WRF_NOSECONDARY);
			Goto Ready;
		Altfire:
			TNT1 A 0 A_JumpIf(PC_GetSilenced(),"Unquietthepistol");
			S1LE A 1 PC_SetSilenced(true);
			S1LE BCDEFGHI 1;
			S1LE J 3;
			TNT1 A 0 A_StartSound("Pistol/silenced", 98);
			S1LE LMMN 1;
			S1LE O 3;
			S1LE PQRSTUV 1;
			Goto SuppressTemp;
		Unquietthepistol:
			TNT1 A 0 PC_SetSilenced(false);
			S1LE VUTSRQP 1;
			S1LE O 3;
			S1LE NM 1;
			TNT1 A 0 A_StartSound("Pistol/unsilenced", 98);
			S1LE MLK 1;
			S1LE J 3;
			S1LE IHGFEDCBA 1;
			Goto SuppressTemp;
		Dryfire:
			PIST F 0 PC_SetSilencedSprite("SILE");
			#### F 4 A_StartSound("Weapons/Pistolempty",11,0);
			Goto Ready;
		Fire:
			TNT1 A 0 A_JumpIf(CountInv("Pistolclip") < 1, "Dryfire");
			PIST A 0 PC_SetSilencedSprite("SILE");
			#### A 1 BRIGHT PC_FirePistol();
			#### B 1 BRIGHT PC_PistolRecoil();
			#### C 1 {
				A_WeaponOffset(0, 37);
				A_ZoomFactor(0.995);
			}
			#### D 1 {
				A_ZoomFactor(1.0);
				A_WeaponReady();
				A_WeaponOffset(0, 35);
			}
			#### E 1 {
				A_WeaponReady();
				A_WeaponOffset(0, 34);
			}
			#### F 1 {
				A_WeaponReady(WRF_NOSWITCH);
				A_WeaponOffset(0, 32);
			}
			Goto Ready;
		Flash:
			TNT1 A 1 A_Light2();
			TNT1 A 1 A_Light1();
			Goto LightDone;
		Reload:
			TNT1 A 0 A_JumpIf(CountInv("Pistolclip") < 1, "EmptyReload");
			PIST F 1 PC_SetSilencedSprite("SILE");
			PISS A 0 PC_SetSilencedSprite("S1LK");
			#### ABC 1;
			PI3R A 0 PC_SetSilencedSprite("3ILR");
			#### ABC 1;
			#### A 0 A_StartSound("Pistol/out", 10);
			#### DEFGHIJK 1 PC_SetSilencedSprite("3ILR");
			#### A 0 A_FireProjectile("Pclipspawner", spawnheight:-10);
			#### LM 1;
			#### MN 5;
			#### NO 1;
			#### A 0 A_StartSound("Pistol/in", 10);
			#### PQRSTUVW 1;
			#### XYZ 1;
			TNT1 A 0 PC_AmmoIntoMag();
			PI4R A 0 PC_SetSilencedSprite("4ILR");
			#### ABCDEF 1;
			PISS A 0 PC_SetSilencedSprite("S1LK");
			#### CBA 1;
			Goto Ready;
		EmptyReload:
			PIST F 1 PC_SetSilencedSprite("SILE");
			PISS A 0 PC_SetSilencedSprite("S1LK");
			#### ABC 1;
			PISR A 0 PC_SetSilencedSprite("SILR");
			#### ABC 1;
			#### A 0 A_StartSound("Pistol/out", 10);
			#### DEFGHIJK 1 PC_SetSilencedSprite("SILR");
			#### A 0 A_FireProjectile("Pclipspawner", spawnheight:-10);
			#### LM 1;
			#### MN 5;
			#### NO 1;
			#### A 0 A_StartSound("Pistol/in", 10);
			#### PQRSTUVW 1;
			#### A 0 A_StartSound("Pistol/cock", 8);
			#### XYZ 1;
			TNT1 A 0 PC_AmmoIntoMag();
			PI2R A 0 PC_SetSilencedSprite("2ILR");
			#### ABCD 1;
			#### A 0 A_StartSound("Pistol/release", 8, CHANF_Overlap);
			#### DEFGHIJKLM 1;
			PISS A 0 PC_SetSilencedSprite("S1LK");
			#### CBA 1;
			Goto Ready;
		Throw:
			PISM A 0 PC_SetSilencedSprite("SILM");
			#### BC 1;
			TNT1 A 0 PC_GetThrowState();
			Wait;
		Returnstate:
			PISM A 0 PC_SetSilencedSprite("SILM");
			#### CBA 1;
			Goto Ready;
		CacheSprites:
			SILM A 0;
			SILE A 0;
			S1LK A 0;
			SILR A 0;
			2ILR A 0;
			3ILR A 0;
			4ILR A 0;
	}
}
