class PC_MedicalSupplies : Inventory {
	Default {
		+INVENTORY.KEEPDEPLETED
		+INVENTORY.INVBAR
		Inventory.MaxAmount 250;
		Inventory.InterHubAmount 250;
		Inventory.Icon "IPRRA0";
		Tag "\c[red]Medical supplies\c-\nRestores up to 100 HP.";
	}
	
	override bool Use(bool pickup) {
		int curHP = owner.health;
		int maxHP = owner.GetMaxHealth();
		if(curHP >= maxHP) return false;
		
		int toGive = clamp(maxHP - curHP, 0, amount);
		owner.GiveBody(toGive);
		owner.TakeInventory(GetClass(), toGive);
		
		sound useSound = "pickup/flaskuse";
		if(toGive >= 50) useSound = "rejkit/use";
		else if(toGive >= 25) useSound = "pickups/pmeduse";
		else if(toGive >= 15) useSound = "pickups/pstimuse";
		owner.A_StartSound(useSound, CHAN_ITEM);
		return false;
	}
}

class PC_ArmorPlates : Inventory {
	Default {
		+INVENTORY.KEEPDEPLETED
		+INVENTORY.INVBAR
		Inventory.MaxAmount 250;
		Inventory.InterHubAmount 250;
		Inventory.Icon "PARMA0";
		Tag "\c[green]Armor plates\c-\nRestores up to 50 AP.";
	}
	
	override void DoEffect() {
		let armor = BasicArmor(owner.FindInventory("BasicArmor"));
		int maxrepair = 50;
		if(armor && armor.amount) {
			string type = armor.armortype;
			type = type.left(10);
			if(!(type ~== "ArmorShard")) maxrepair = armor.actualsaveamount;
		}
		SetTag(string.format("\c[green]Armor plates\c-\nRestores up to %d AP.", maxrepair));
	}
	
	override bool Use(bool pickup) {
		let armor = BasicArmor(owner.FindInventory("BasicArmor"));
		if(!armor || armor.amount >= armor.actualsaveamount) return false;
		
		int max = 50;
		string type = armor.armortype;
		type = type.left(10);
		if(armor.amount && !(type ~== "ArmorShard")) max = armor.actualsaveamount;
		int toGive = clamp(max - armor.amount, 0, amount);
		
		if(type ~== "ArmorShard" && armor.amount > 50) return false;
		
		if(armor.amount && !(type ~== "ArmorShard"))
			owner.GiveInventory("PC_ArmorPlateBonus", toGive);
		else
			owner.GiveInventory("PC_PlateVest", 1);
		owner.TakeInventory(GetClass(), toGive);
		
		sound useSound = "armorcharge/use";
		if(toGive >= 25) useSound = "armorplate/use";
		else if(toGive >= 15) useSound = "armorboost/use";
		owner.A_StartSound(useSound, CHAN_ITEM);
		return false;
	}
}

class PC_PlateVest : BasicArmorPickup {
	Default {
		Armor.SaveAmount 50;
		Armor.Savepercent 35;
		Inventory.Icon "PARMA0";
	}
}

class PC_ArmorPlateBonus : ArmorBonus {
	Default {
		Armor.SaveAmount 1;
		Armor.Savepercent 35;
		Armor.MaxSaveAmount 500;
		Inventory.Icon "PARMA0";
	}
}

class Packsoammo : Inventory {
	Default {
		Inventory.Amount 1;
		Inventory.MaxAmount 10;
		Inventory.InterHubAmount 10;
		Inventory.PickupSound "pickups/iammosatchel";
		Inventory.UseSound "Pickups/Ammouse";
		Tag "$ammo";
		Inventory.PickupMessage "UAC-brand 'stop wasting ammo, asshole!'  \c[Backpackcolor]Ammo Satchel\c-. (Some ammo)";
		Inventory.Icon "ASATA0";
		+INVENTORY.INVBAR
		+FLOORCLIP
	}
	
	static const string satchelTypes[] = {
		"Bullets",
		"RevBullets",
		"Shells",
		//"EShells",
		"HeavyBullets",
		//"PC_ExplosiveBullets",
		"Rockets",
		//"PC_Fuel",
		"PlasmaCell",
		"DTech",
		"HGAmmo",
		"MineAmmo",
		"C4Ammo"
	};
	
	override bool Use(bool pickup) {
		bool shouldConsume;
		int extraPacks;
		int typesGiven;
		
		for(int i = 0; i < satchelTypes.Size(); i++) {
			class<Ammo> ammoClass = satchelTypes[i];
			if(!ammoClass) continue;
			int maxAmt = owner.GetAmmoCapacity(ammoClass);
			int curAmt = owner.CountInv(ammoClass);
			if(curAmt < maxAmt) typesGiven++;
		}
		
		for(int i = 0; i < satchelTypes.Size(); i++) {
			class<Ammo> ammoClass = satchelTypes[i];
			if(!ammoClass) continue;
			int toGive = GetDefaultByType(ammoClass).backpackamount;
			int maxAmt = owner.GetAmmoCapacity(ammoClass);
			int curAmt = owner.CountInv(ammoClass);
			int packs = 1;
			if(typesGiven == satchelTypes.Size()) {
				packs = clamp((maxAmt - curAmt) / toGive, 0, amount);
			}
			if(curAmt < maxAmt) {
				extraPacks = max(extraPacks, packs - 1);
				owner.GiveInventory(ammoClass, toGive * packs);
				shouldConsume = true;
			}
		}
		
		if(shouldConsume) {
			if(extraPacks) {
				owner.TakeInventory(GetClass(), extraPacks);
			}
			return true;
		}
		return false;
	}
		
}
